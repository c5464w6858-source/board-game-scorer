{
  "name": "child-organiser-native",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor 6 wrapper for the Child Organiser PWA (uk.includeme.organiser)",
  "scripts": {
    "sync": "bash scripts/sync-web.sh && npx cap sync",
    "android:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run sync && cd android && ./gradlew bundleRelease",
    "test:shim": "NODE_PATH=$(npm root -g) node test/shim-test.js",
    "screenshots": "NODE_PATH=$(npm root -g) node test/screenshots.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.4.0"
  }
}