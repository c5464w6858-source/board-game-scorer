# ── Front-end (safe to expose; these are public keys) ─────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: only if you call Google Places from the browser directly (NOT
# recommended). Prefer the serverless proxy below, which keeps the key private.
# VITE_GOOGLE_PLACES_API_KEY=...

# ── Server-side only (set in your host's dashboard, never commit) ─────────────
# Used by netlify/functions/place-photo.js
GOOGLE_PLACES_API_KEY=your-google-places-key
# Used by the optional Supabase Edge Function for transactional emails
RESEND_API_KEY=your-resend-key
